; Engine configuration file for Aether Gauntlet.
; Godot 4.3 project settings.

config_version=5

[application]

config/name="Aether Gauntlet"
config/description="A top-down action RPG of classes, crystals and gauntlet waves."
config/version="0.1.0"
run/main_scene="res://scenes/world/Bootstrap.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"
run/flush_stdout_on_print=true

[autoload]

EventBus="*res://autoload/EventBus.gd"
GameState="*res://autoload/GameState.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

